{
 "name": "scratch",
 "version": "1.0.0",
 "private": true,
 "workspaces": [
  "backend"
 ],
 "scripts": {
  "dev:backend": "npm run start:dev --workspace=backend",
  "dev:frontend": "npm run dev --workspace=frontend",
  "build:backend": "npm run build --workspace=backend",
  "build:frontend": "npm run build --workspace=frontend"
 },
 "devDependencies": {
  "prisma": "^6.19.3"
 },
 "allowScripts": {
  "@prisma/engines": true,
  "prisma": true,
  "bcrypt@6.0.0": true,
  "@prisma/client": true,
  "@parcel/watcher": true,
  "unrs-resolver": true
 }
}
